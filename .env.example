# AI-Powered Resume Intelligence - Environment Configuration
# Copy this file to .env and adjust as needed.

# Sentence Transformer model name (downloaded on first run)
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# spaCy model name
SPACY_MODEL_NAME=en_core_web_sm

# Maximum upload file size in bytes (default: 5MB)
MAX_FILE_SIZE_BYTES=5242880

# Maximum number of resumes per batch
MAX_BATCH_SIZE=10

# Streamlit server port
STREAMLIT_PORT=8501
